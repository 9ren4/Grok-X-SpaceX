# --- Grok (copy generation). Without it, deterministic templates are used. ---
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL_SMART=grok-4
GROK_MODEL_FAST=grok-4-fast

# --- Notion (run sheet / budget / rota destination) ---
# Internal integration token, and the page the event pages are created under.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# --- Ghost (newsletter) ---
GHOST_ADMIN_URL=https://yoursite.ghost.io
GHOST_ADMIN_KEY=            # id:secret from Integrations
GHOST_NEWSLETTER_SLUG=default-newsletter

# --- Supabase (sponsors / venues / past events). Optional. ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=           # graph page reads with this (public-read policies only)

# --- Cognee (shared knowledge graph). Optional. ---
# Cognee is driven through the same Grok key by default.
COGNEE_LLM_PROVIDER=custom
COGNEE_EMBEDDING_PROVIDER=fastembed
