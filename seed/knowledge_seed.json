   "provenance": "Hack the Thames Weekend",
   "entity": "venue:Canary Wharf Tech Hub"
  },
  {
   "kind": "venue",
   "text": "Clerkenwell Coworking Studio has no kitchen, so catering must arrive ready to serve; bins are limited to two, bring extra bags.",
   "tags": [
    "venue",
    "kitchen",
    "catering",
    "clerkenwell"
   ],
   "provenance": "Founders & Flat Whites Breakfast",
   "entity": "venue:Clerkenwell Coworking Studio"
  },
  {
   "kind": "venue",
   "text": "King's Cross Library Hall bans alcohol; the projector needs an HDMI-C adapter. Doors open 17:30, good for workshops.",
   "tags": [
    "venue",
    "alcohol",
    "projector",
    "workshop",
    "king's cross"
   ],
   "provenance": "Prompt Engineering Workshop Night",
   "entity": "venue:King's Cross Library Hall"
  },
  {
   "kind": "venue",
   "text": "Brixton Warehouse Taproom is echoey: hire handheld mics or talks are unintelligible past row 4.",
