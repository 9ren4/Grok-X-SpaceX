 "memories": [
  {
   "kind": "budget",
   "text": "60 people ate 15 pizzas, GBP 142 from Slice & Co Catering (about 4 people per pizza, 9.50 per pizza plus delivery). Order 15 for 60 and almost nothing was left.",
   "tags": [
    "pizza",
    "food",
    "catering",
    "per-head",
    "quantity"
   ],
   "provenance": "London AI Builders Meetup #12",
   "entity": "supplier:Slice & Co Catering"
  },
  {
   "kind": "budget",
   "text": "Food cost came to about GBP 2.37 per head at the AI Builders meetup (pizza only). Adding coffee brought it to GBP 3.90 per head.",
   "tags": [
    "cost-per-head",
    "food",
    "meetup"
   ],
   "provenance": "London AI Builders Meetup #12",
   "entity": null
  },
  {
   "kind": "budget",
   "text": "Bean There Coffee Cart charged GBP 2.80 per head for unlimited filter and tea at a 60 person evening meetup; about 70% of people took one.",
   "tags": [
    "coffee",
    "drinks",
    "per-head"
   ],
   "provenance": "London AI Builders Meetup #12",
   "entity": "supplier:Bean There Coffee Cart"
  },
  {
   "kind": "budget",
   "text": "Always order 20% vegetarian and 10% vegan pizzas: 3 of 15 were vegetarian and all gone first.",
   "tags": [
    "pizza",
    "dietary",
    "vegetarian",
    "vegan",
    "food"
   ],
   "provenance": "London AI Builders Meetup #12",
   "entity": "supplier:Slice & Co Catering"
  },
  {
   "kind": "budget",
   "text": "120 hackathon attendees got 34 pizzas on Saturday night (GBP 323 from Slice & Co) plus breakfast pastries; roughly 3.5 people per pizza when people stay for hours.",
   "tags": [
    "pizza",
    "food",
    "hackathon",
    "quantity"
   ],
   "provenance": "Hack the Thames Weekend",
   "entity": "supplier:Slice & Co Catering"
  },
  {
   "kind": "budget",
   "text": "Total spend for the 2 day hackathon was GBP 2,840 (GBP 23.70 per head), covered by Northwind Cloud GBP 1,500 and Fennel Ventures GBP 800.",
   "tags": [
    "cost-per-head",
    "hackathon",
    "budget",
    "sponsor"
   ],
   "provenance": "Hack the Thames Weekend",
   "entity": null
  },
  {
   "kind": "budget",
   "text": "Crumbs Vegan Catering charged GBP 11 per head for a 35 person breakfast; minimum order 30 people and 7 days notice.",
   "tags": [
    "vegan",
    "catering",
    "breakfast",
    "per-head"
   ],
   "provenance": "Founders & Flat Whites Breakfast",
   "entity": "supplier:Crumbs Vegan Catering"
  },
  {
   "kind": "budget",
   "text": "Drinks at the social cost GBP 6.50 per head via Pint Pot Drinks Co; expect 2.2 drinks per person across a 3 hour evening.",
   "tags": [
    "drinks",
    "bar",
    "per-head",
    "social"
   ],
   "provenance": "Data After Dark Social",
   "entity": "supplier:Pint Pot Drinks Co"
  },
  {
   "kind": "budget",
   "text": "A typical 60 person London evening meetup lands at GBP 6 to 9 per head all-in (food, drinks, print, AV) when the venue is free or cheap.",
   "tags": [
    "cost-per-head",
    "meetup",
    "budget"
   ],
   "provenance": "London AI Builders Meetup #12",
   "entity": null
  },
  {
   "kind": "budget",
   "text": "Lumen AV Hire day rate is GBP 320 for a PA, two handheld mics and a lectern mic; book 10 days ahead.",
   "tags": [
    "av",
    "mics",
    "hire",
    "budget"
   ],
   "provenance": "Hack the Thames Weekend",
   "entity": "supplier:Lumen AV Hire"
  },
  {
   "kind": "budget",
   "text": "Print for 60 attendees (badges, signage, 2 banners) cost GBP 64 from Thames Print Studio; 3 day turnaround.",
   "tags": [
    "print",
    "badges",
    "signage"
   ],
   "provenance": "London AI Builders Meetup #12",
   "entity": "supplier:Thames Print Studio"
  },
  {
   "kind": "venue",
   "text": "The Shoreditch Loft is on the 3rd floor with no lift: tell guests, and plan two volunteers to help carry catering up. Hard curfew at 22:00.",
   "tags": [
    "venue",
    "accessibility",
    "curfew",
    "shoreditch"
   ],
   "provenance": "London AI Builders Meetup #12",
   "entity": "venue:The Shoreditch Loft"
  },
  {
   "kind": "venue",
   "text": "The Shoreditch Loft held 60 people comfortably standing but felt full at 75; the fire limit is 80.",
   "tags": [
    "venue",
    "capacity",
    "shoreditch"
   ],
   "provenance": "Data After Dark Social",
   "entity": "venue:The Shoreditch Loft"
  },
  {
   "kind": "venue",
   "text": "Canary Wharf Tech Hub is free for communities but security needs the final guest list 48 hours ahead; walk-ins are turned away.",
